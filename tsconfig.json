{
  "compilerOptions": {
    "strict": true,
    "noEmitOnError": true,
    "noUncheckedIndexedAccess": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "rootDir": "ui",
    "outDir": "target/frontend",
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": ["ui/**/*.ts"],
  "exclude": ["ui/tests/**"]
}
