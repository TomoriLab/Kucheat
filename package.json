{
  "name": "kucheat-desktop",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.tools.json && node target/tools/scripts/build-frontend.js",
    "check": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.tools.json --noEmit",
    "test": "tsc --project tsconfig.tools.json && node --test target/tools/ui/tests/*.test.js"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
